{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@aegis": ["./src/aegis/enabled.tsx"],
      "@legacy": ["./src/legacy/disabled.tsx"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/legacy/security.tsx",
    "src/components/sections/DashboardSection.tsx",
    "src/components/sections/ThreatDetectionSection.tsx",
    "src/components/sections/network-security",
    "src/components/sections/vulnerabilities",
    "src/components/sections/ReportsSection.tsx",
    "src/components/AIAnalysisSection.tsx",
    "src/components/ScanProgressIndicator.tsx",
    "src/contexts/ScanContext.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}